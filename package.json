{
  "name": "sphere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sphere by MI Group: talk to a team of AI models with one shared context.",
  "scripts": {
    "dev": "tsx watch --ignore web server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@electric-sql/pglite": "^0.5.11",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "fflate": "^0.8.2",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "node-ical": "^0.27.3",
    "nodemailer": "^10.2.1",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdav": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
