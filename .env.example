# Postgres connection (Neon). Leave unset locally to use an embedded database in ./.data
DATABASE_URL=

# Password for the Sphere web app. Required in production.
SPHERE_PASSWORD=
# Random string used to sign the login cookie. Render generates one automatically.
SESSION_SECRET=

# One key per provider. A seat whose key is missing shows as "not connected" and is skipped.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
META_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# Time zone for dates the team sees (calendar, briefing).
SPHERE_TIMEZONE=America/New_York

# Email: the migroupco.com mailbox on the web host's mail server.
MAIL_IMAP_HOST=mail.migroupco.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=mail.migroupco.com
MAIL_SMTP_PORT=465
MAIL_USER=
MAIL_PASSWORD=
# Optional display name for sent mail, e.g. Ricardo Berris <ricardo@migroupco.com>
MAIL_FROM=

# Calendar: iCloud, read-only. Use an app-specific password from appleid.apple.com.
ICLOUD_USER=
ICLOUD_APP_PASSWORD=

# Natural voices use OPENAI_API_KEY. Set SPHERE_TTS=off to use the browser's built-in voices instead.
SPHERE_TTS=
# Speech model override (default gpt-4o-mini-tts, falls back to tts-1).
SPHERE_TTS_MODEL=

# Set to 1 to run with canned replies and no API calls (for testing the UI).
SPHERE_MOCK=
